# ============================================
# AI Limited Edition Product Tracker
# Environment Configuration
# ============================================

# Telegram Bot Configuration
# Create a bot via @BotFather on Telegram to get the token
TELEGRAM_BOT_TOKEN=your_bot_token_here

# Your Telegram Chat ID (send /start to @userinfobot to find yours)
TELEGRAM_CHAT_ID=your_chat_id_here

# Scraping Configuration
# How often to check products (in seconds). Default: 180 (3 minutes)
SCRAPE_INTERVAL_SECONDS=180

# Database Configuration
# SQLite database path
DATABASE_URL=sqlite+aiosqlite:///./tracker.db

# Custom User-Agent for HTTP requests
USER_AGENT=Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/125.0.0.0 Safari/537.36
